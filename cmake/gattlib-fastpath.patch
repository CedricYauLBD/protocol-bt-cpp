+static gboolean check_characteristics_ready(gpointer user_data)
+{
+	gatt_connection_t* connection = user_data;
+	gattlib_context_t* conn_context = connection->context;
+	GDBusObjectManager *device_manager = get_device_manager_from_adapter(conn_context->adapter);
+
+	GList *objects = g_dbus_object_manager_get_objects(device_manager);
+	for (GList *l = objects; l != NULL; l = l->next) {
+		GDBusObject *obj = l->data;
+		const char* path = g_dbus_object_get_object_path(G_DBUS_OBJECT(obj));
+		if (path && strstr(path, conn_context->device_object_path)) {
+			GDBusInterface *iface = g_dbus_object_manager_get_interface(device_manager, path, "org.bluez.GattCharacteristic1");
+			if (iface) {
+				g_object_unref(iface);
+				g_list_free_full(objects, g_object_unref);
+				GATTLIB_LOG(GATTLIB_INFO, ">>> FAST-PATH: Characteristics detected on D-Bus - quitting wait loop! <<<");
+				if (conn_context->connection_loop && g_main_loop_is_running(conn_context->connection_loop)) {
+					g_main_loop_quit(conn_context->connection_loop);
+				}
+				return G_SOURCE_REMOVE;
+			}
+		}
+	}
+	g_list_free_full(objects, g_object_unref);
+	return G_SOURCE_CONTINUE;
+}
